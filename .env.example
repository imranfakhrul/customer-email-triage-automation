# ==============================================================================
# Customer Email Triage Automation - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Groq API Key (used for Main Triage LLM & Fallback Classifier)
GROQ_API_KEY=your_groq_api_key_here

# Jev AI API Key (used for Inbound Spam & Gatekeeper)
JEV_API_KEY=your_jev_api_key_here

# Destination: Engineering (GitHub Personal Access Token)
GITHUB_TOKEN=your_github_token_here

# Destination: Support (FreeScout API Key)
FREESCOUT_API_KEY=your_freescout_api_key_here

# Destination: Sales (Internal CRM Endpoint & Secret)
CRM_API_ENDPOINT=https://crm.example.com/api/v1/leads
CRM_API_KEY=your_crm_api_key_here

# Destination: Billing (Slack Webhook URL)
SLACK_BILLING_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# System Settings (Optional override)
DATABASE_PATH=triage.db
