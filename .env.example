# ==============================================================================
# Customer Email Triage Automation — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your real production or test keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Decision Engine & Gatekeeper Credentials
# ------------------------------------------------------------------------------
# TypeSafe System One (Jev) API key for gatekeeper scoring (obtain at: https://typesafe.ai)
JEV_API_KEY=your_jev_api_key_here

# Fast Inference & LLM Engine (Groq fallback & classification intelligence)
# Obtain a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# LLM Models Configuration
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 2. Storage & System Settings
# ------------------------------------------------------------------------------
# Path to persistent SQLite idempotency database
DATABASE_PATH=triage.db

# Idempotency stale lock timeout (in minutes)
IDEMPOTENCY_STALE_MINUTES=10

# Max dispatch retries before dead-letter queue
MAX_DISPATCH_RETRIES=3

# ------------------------------------------------------------------------------
# 3. Downstream Destination Integrations (Optional / Staging)
# ------------------------------------------------------------------------------
# Engineering Destination: GitHub Issues Integration
GITHUB_TOKEN=your_github_token_here

# Support Destination: FreeScout Helpdesk Integration
FREESCOUT_API_KEY=your_freescout_api_key_here

# Sales Destination: CRM Lead Ingestion Endpoint & Secret
CRM_API_ENDPOINT=https://crm.example.com/api/v1/leads
CRM_API_KEY=your_crm_api_key_here

# Billing Destination: Billing Alert Webhook (Slack / Discord)
SLACK_BILLING_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
